          aria-modal="true"
        >
          <div className="w-full max-w-md rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-[#111824] p-6 shadow-2xl space-y-4">
            <div className="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
              <h2 className="text-sm font-bold text-slate-900 dark:text-slate-100">
                Modify SL / TP · {modifyTarget.pair} ({modifyTarget.direction})
              </h2>
              <button
                type="button"
                onClick={() => setModifyTarget(null)}
                className="rounded-md p-1 text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-[11px] text-slate-500 dark:text-slate-400 mb-1">
                  Stop Loss
                </label>
                <input
                  type="number"
                  step="any"
                  value={modifySl}
                  onChange={(e) => setModifySl(e.target.value)}
                  className="w-full rounded-lg border border-slate-300 bg-slate-50 dark:border-slate-700 dark:bg-[#0B0F17] px-3 py-2 font-mono text-xs text-slate-900 dark:text-slate-100"
                />
              </div>
              <div>
                <label className="block text-[11px] text-slate-500 dark:text-slate-400 mb-1">
                  Take Profit
                </label>
                <input
                  type="number"
                  step="any"
                  value={modifyTp}
                  onChange={(e) => setModifyTp(e.target.value)}
                  className="w-full rounded-lg border border-slate-300 bg-slate-50 dark:border-slate-700 dark:bg-[#0B0F17] px-3 py-2 font-mono text-xs text-slate-900 dark:text-slate-100"
                />
              </div>
            </div>

            <div className="flex justify-end gap-2 pt-2">
              <button
                type="button"
                onClick={() => setModifyTarget(null)}
                className="rounded-lg border border-slate-300 bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={() => setConfirmModifyOpen(true)}
                className="rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-500"
              >
                Review Modification
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Confirmation Dialogs */}
      <ConfirmDialog
        open={confirmOpen}
        title={isRunning ? 'Stop Trading Bot?' : 'Start Trading Bot?'}
        description={
          isRunning
            ? 'Stopping the bot halts new signal evaluation and order placement. Any currently open broker positions will remain open unless closed manually.'
            : `Starting the bot arms ${botStatus?.activeStrategiesCount ?? 0} active strategies to scan markets and submit orders to your connected broker account.`
        }
        confirmLabel={isRunning ? 'Stop Bot' : 'Start Bot'}
        variant={isRunning ? 'danger' : 'primary'}
        isProcessing={isTogglingBot}
        onConfirm={handleConfirmToggleBot}
        onCancel={() => setConfirmOpen(false)}
      />

      <ConfirmDialog
        open={Boolean(closeTarget)}
        title={`Manually Close ${closeTarget?.pair ?? ''} Position?`}
        description={
          closeTarget
            ? `Close ${closeTarget.direction} ${closeTarget.sizeLots.toFixed(2)} lots of ${closeTarget.pair} at current market price? Estimated floating P/L: ${formatDisplayAmount(closeTarget.floatingPnl, sourceCurrency, { signed: true })}.`
            : ''
        }
        confirmLabel="Close Position Now"
        variant="danger"
        isProcessing={closingPos}
        onConfirm={handleConfirmClosePosition}
        onCancel={() => setCloseTarget(null)}
      />

      <ConfirmDialog
        open={confirmModifyOpen}
        title={`Confirm SL / TP Update for ${modifyTarget?.pair ?? ''}?`}
        description={`Update Stop Loss to ${modifySl} and Take Profit to ${modifyTp} on broker ticket ${modifyTarget?.id ?? ''}?`}
        confirmLabel="Apply SL / TP"
        variant="primary"
        isProcessing={modifyingPos}
        onConfirm={handleConfirmModifySlTp}
        onCancel={() => setConfirmModifyOpen(false)}
      />

      <ConfirmDialog
        open={confirmManualOpen}
        title={`Submit Manual ${manualDir} Order on ${manualPair}?`}
        description={`Confirm manual ${manualDir} execution for ${manualLots} lots of ${manualPair} (SL: ${manualSl}, TP: ${manualTp}). This bypasses automated strategy grading.`}
        confirmLabel="Execute Manual Order"
        variant="danger"
        isProcessing={submittingManual}
        onConfirm={handleConfirmManualOrder}
        onCancel={() => setConfirmManualOpen(false)}
      />
    </div>
  );
}

function KpiCard({
  label,
  value,
  subtext,
  valueTone = 'neutral',
}: {
  label: string;
  value: string;
  subtext: string;
  valueTone?: 'neutral' | 'profit' | 'loss';
}) {
  const toneClass =
    valueTone === 'profit'
      ? 'text-emerald-600 dark:text-emerald-400'
      : valueTone === 'loss'
      ? 'text-red-600 dark:text-red-400'
      : 'text-slate-900 dark:text-slate-100';

  return (
    <div className="rounded-xl border border-slate-200 bg-white dark:border-slate-800/90 dark:bg-[#111824] p-4">
      <p className="text-xs font-medium text-slate-500 dark:text-slate-400">{label}</p>
      <p className={`mt-1.5 font-mono text-lg font-bold tracking-tight tabular-nums ${toneClass}`}>
        {value}
      </p>
      <p className="mt-1 text-[11px] text-slate-500 truncate">{subtext}</p>
    </div>
  );
}
</file>

<file path="trading-bot-control-center/src/pages/DataManagerPage.tsx">
import { useCallback, useEffect, useState } from 'react';
import {
  CheckCircle2,
  DownloadCloud,
  Eye,
  RefreshCw,
  ShieldCheck,
  X,
} from 'lucide-react';
import { api } from '../services/api';
import type { DataGap, HistoricalDataset } from '../types';
import { PanelShell } from '../components/DataState';
import { formatDateTime } from '../utils/formatters';

export function DataManagerPage() {
  const [datasets, setDatasets] = useState<HistoricalDataset[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [busyId, setBusyId] = useState<string | null>(null);
  const [notice, setNotice] = useState<string | null>(null);

  const [gapsModalDataset, setGapsModalDataset] = useState<HistoricalDataset | null>(null);
  const [gaps, setGaps] = useState<DataGap[]>([]);
  const [loadingGaps, setLoadingGaps] = useState(false);

  const loadDatasets = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const list = await api.getDatasets();
      setDatasets(list);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to load historical datasets');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void loadDatasets();
  }, [loadDatasets]);

  const handleDownload = async (ds: HistoricalDataset) => {
    setBusyId(ds.id);
    setNotice(null);
    try {
      const updated = await api.downloadDataset(ds.id);
      setDatasets((prev) => prev.map((d) => (d.id === ds.id ? updated : d)));
      setNotice(`Synced latest ${ds.pair} ${ds.timeframe} candles from broker archive.`);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Dataset download failed');
    } finally {
      setBusyId(null);
    }
  };

  const handleValidate = async (ds: HistoricalDataset) => {
    setBusyId(ds.id);
    setNotice(null);
    try {
      const updated = await api.validateDataset(ds.id);
      setDatasets((prev) => prev.map((d) => (d.id === ds.id ? updated : d)));
      setNotice(
        `Integrity check completed for ${ds.pair} ${ds.timeframe}: ${updated.gapsFound} gap(s) logged.`
      );
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Validation failed');
    } finally {
      setBusyId(null);
    }
  };

  const handleViewGaps = async (ds: HistoricalDataset) => {
    setGapsModalDataset(ds);
    setLoadingGaps(true);
    setGaps([]);
    try {
      const found = await api.getDatasetGaps(ds.id);
      setGaps(found);
    } finally {
      setLoadingGaps(false);
    }
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 className="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Historical Data Manager
          </h1>
          <p className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
            Inspect cached OHLCV candle stores, trigger broker backfills, validate continuity, and audit missing bar gaps.
          </p>
        </div>

        <button
          type="button"
          onClick={() => void loadDatasets()}
          className="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 transition-colors whitespace-nowrap"
        >
          <RefreshCw className="h-3.5 w-3.5" />
          Refresh Store
        </button>
      </div>

      {notice && (
        <div className="flex items-center gap-2 rounded-xl border border-emerald-500/35 bg-emerald-500/10 px-4 py-2.5 text-xs text-emerald-800 dark:text-emerald-300">
          <CheckCircle2 className="h-4 w-4 shrink-0" />
          <span>{notice}</span>
        </div>
      )}

      <PanelShell
        title="Pair & Timeframe Archives"
        subtitle="Cached Parquet / SQL candle partitions used by the FastAPI backtester"
        isLoading={loading}
        error={error}
        isEmpty={datasets.length === 0}
        onRetry={loadDatasets}
        skeletonRows={6}
      >
        <div className="overflow-x-auto">
          <table className="w-full text-left text-xs">
            <thead>
              <tr className="border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 whitespace-nowrap">
                <th className="py-2.5 pr-3 font-medium">Pair</th>
                <th className="py-2.5 px-3 font-medium">Timeframe</th>
                <th className="py-2.5 px-3 font-medium">Start Date</th>
                <th className="py-2.5 px-3 font-medium">End Date</th>
                <th className="py-2.5 px-3 font-medium text-right">Candles</th>
                <th className="py-2.5 px-3 font-medium text-right">Gaps Found</th>
                <th className="py-2.5 px-3 font-medium">Last Updated</th>
                <th className="py-2.5 px-3 font-medium">Status</th>
                <th className="py-2.5 pl-3 font-medium text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-200 dark:divide-slate-800/70">
              {datasets.map((ds) => {
                const isBusy = busyId === ds.id;
                return (
                  <tr key={ds.id} className="hover:bg-slate-50 dark:hover:bg-slate-800/35">
                    <td className="py-3 pr-3 font-mono font-semibold text-slate-900 dark:text-slate-100 whitespace-nowrap">
                      {ds.pair}
                    </td>
                    <td className="py-3 px-3 font-mono text-slate-700 dark:text-slate-300 whitespace-nowrap">
                      {ds.timeframe}
                    </td>
                    <td className="py-3 px-3 font-mono text-slate-600 dark:text-slate-300 tabular-nums whitespace-nowrap">
                      {ds.startDate}
                    </td>
                    <td className="py-3 px-3 font-mono text-slate-600 dark:text-slate-300 tabular-nums whitespace-nowrap">
                      {ds.endDate}
                    </td>
                    <td className="py-3 px-3 text-right font-mono tabular-nums text-slate-800 dark:text-slate-200 whitespace-nowrap">
                      {ds.candleCount.toLocaleString('en-US')}
                    </td>
                    <td className="py-3 px-3 text-right font-mono tabular-nums whitespace-nowrap">
                      <span
                        className={
                          ds.gapsFound > 0
                            ? 'font-semibold text-amber-600 dark:text-amber-400'
                            : 'text-emerald-600 dark:text-emerald-400'
                        }
                      >
                        {ds.gapsFound}
                      </span>
                    </td>
                    <td className="py-3 px-3 font-mono text-[11px] text-slate-500 dark:text-slate-400 whitespace-nowrap">
                      {formatDateTime(ds.lastUpdated)}
                    </td>
                    <td className="py-3 px-3 whitespace-nowrap">
                      <span
                        className={`rounded border px-2 py-0.5 text-[11px] font-medium ${
                          ds.status === 'Up to date'
                            ? 'border-emerald-500/35 bg-emerald-500/12 text-emerald-700 dark:text-emerald-300'
                            : 'border-amber-500/35 bg-amber-500/12 text-amber-700 dark:text-amber-300'
                        }`}
                      >
                        {ds.status}
                      </span>
                    </td>
                    <td className="py-3 pl-3 text-right whitespace-nowrap">
                      <div className="inline-flex items-center gap-1.5">
                        <button
                          type="button"
                          disabled={isBusy}
                          onClick={() => void handleDownload(ds)}
                          className="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 disabled:opacity-50"
                        >
                          <DownloadCloud className="h-3 w-3" />
                          Update
                        </button>
                        <button
                          type="button"
                          disabled={isBusy}
                          onClick={() => void handleValidate(ds)}
                          className="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 disabled:opacity-50"
                        >
                          <ShieldCheck className="h-3 w-3" />
                          Validate
                        </button>
                        <button
                          type="button"
                          onClick={() => void handleViewGaps(ds)}
                          className="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2.5 py-1 text-[11px] font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                        >
                          <Eye className="h-3 w-3" />
                          Gaps
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </PanelShell>

      {/* View Gaps Modal */}
      {gapsModalDataset && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/55 dark:bg-black/70 p-4 backdrop-blur-xs"
          role="dialog"
          aria-modal="true"
        >
          <div className="w-full max-w-2xl rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-[#111824] p-6 shadow-2xl max-h-[85vh] overflow-y-auto">
            <div className="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3 mb-4">
              <div>
                <h2 className="text-base font-bold text-slate-900 dark:text-slate-100">
                  Detected Candle Gaps · {gapsModalDataset.pair} ({gapsModalDataset.timeframe})
                </h2>
                <p className="text-xs text-slate-500 dark:text-slate-400">
                  Missing bar timestamps excluded from indicator lookback windows
                </p>
              </div>
              <button
                type="button"
                onClick={() => setGapsModalDataset(null)}
                className="rounded-md p-1 text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            {loadingGaps ? (
              <div className="py-8 text-center text-xs text-slate-500">Scanning gap index...</div>
            ) : gaps.length === 0 ? (
              <div className="rounded-lg border border-emerald-500/35 bg-emerald-500/10 p-4 text-xs text-emerald-700 dark:text-emerald-300">
                Zero continuity gaps detected in {gapsModalDataset.pair} {gapsModalDataset.timeframe}.
              </div>
            ) : (
              <div className="space-y-2.5">
                {gaps.map((g) => (
                  <div
                    key={g.id}
                    className="rounded-lg border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-[#0B0F17] p-3 text-xs"
                  >
                    <div className="flex flex-wrap items-center justify-between gap-2">
                      <span className="font-mono font-semibold text-slate-900 dark:text-slate-100">
                        {formatDateTime(g.gapStart)} → {formatDateTime(g.gapEnd)}
                      </span>
                      <span className="font-mono text-amber-600 dark:text-amber-400 font-semibold">
                        {g.missingCandles} missing bar{g.missingCandles === 1 ? '' : 's'}
                      </span>
                    </div>
                    <p className="mt-1 text-slate-600 dark:text-slate-400">{g.reason}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="trading-bot-control-center/src/pages/IndicatorsPage.tsx">
import { useCallback, useEffect, useState, type FormEvent } from 'react';
import { Check, Pencil, Plus, Save, X } from 'lucide-react';
import { api } from '../services/api';
import type { Indicator, IndicatorParameter } from '../types';
import { PanelShell } from '../components/DataState';

const CATEGORIES: Indicator['category'][] = [
  'Trend',
  'Momentum',
  'Volatility',
  'Volume',
  'Structure',
];

export function IndicatorsPage() {
  const [indicators, setIndicators] = useState<Indicator[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [categoryFilter, setCategoryFilter] = useState<'ALL' | Indicator['category']>('ALL');

  const [editingIndicator, setEditingIndicator] = useState<Indicator | null>(null);
  const [savingEdit, setSavingEdit] = useState(false);

  const [addOpen, setAddOpen] = useState(false);
  const [newName, setNewName] = useState('');
  const [newShortCode, setNewShortCode] = useState('');
  const [newCategory, setNewCategory] = useState<Indicator['category']>('Momentum');
  const [newDescription, setNewDescription] = useState('');
  const [newParamLabel, setNewParamLabel] = useState('Lookback Period');
  const [newParamDefault, setNewParamDefault] = useState(14);
  const [creating, setCreating] = useState(false);

  const [savedId, setSavedId] = useState<string | null>(null);

  const loadIndicators = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const data = await api.getIndicators();
      setIndicators(data);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to load indicators');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void loadIndicators();
  }, [loadIndicators]);

  const handleSaveEdit = async () => {
    if (!editingIndicator) return;
    setSavingEdit(true);
    try {
      const updated = await api.updateIndicator(editingIndicator.id, {
        parameters: editingIndicator.parameters,
        description: editingIndicator.description,
      });
      setIndicators((prev) =>
        prev.map((i) => (i.id === updated.id ? updated : i))
      );
      setSavedId(updated.id);
      setEditingIndicator(null);
      window.setTimeout(() => setSavedId(null), 2000);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to update indicator');
    } finally {
      setSavingEdit(false);
    }
  };

  const handleCreateCustom = async (e: FormEvent) => {
    e.preventDefault();
    if (!newName.trim() || !newShortCode.trim()) return;
    setCreating(true);
    try {
      const params: IndicatorParameter[] = [
        {
          key: 'period',
          label: newParamLabel.trim() || 'Period',
          type: 'number',
          defaultValue: newParamDefault,
          min: 1,
          max: 500,
          step: 1,
        },
      ];
      const created = await api.createIndicator({
        name: newName.trim(),
        shortCode: newShortCode.trim().toUpperCase(),
        category: newCategory,
        description: newDescription.trim() || 'Custom indicator module.',
        parameters: params,
      });
      setIndicators((prev) => [...prev, created]);
      setAddOpen(false);
      setNewName('');
      setNewShortCode('');
      setNewDescription('');
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to create indicator');
    } finally {
      setCreating(false);
    }
  };

  const filtered =
    categoryFilter === 'ALL'
      ? indicators
      : indicators.filter((i) => i.category === categoryFilter);

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 className="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            Indicators Library
          </h1>
          <p className="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
            Technical indicators computed by the Python backend engine. Configure default parameters or register custom entries.
          </p>
        </div>

        <button
          type="button"
          onClick={() => setAddOpen(true)}
          className="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-500 transition-colors whitespace-nowrap"
        >
          <Plus className="h-4 w-4" />
          Add Custom Indicator
        </button>
      </div>

      {/* Category Filter Bar */}
      <div className="flex flex-wrap items-center gap-1.5 rounded-xl border border-slate-200 bg-white dark:border-slate-800/90 dark:bg-[#111824] p-2">
        {(['ALL', ...CATEGORIES] as const).map((cat) => (
          <button
            key={cat}
            type="button"
            onClick={() => setCategoryFilter(cat)}
            className={`rounded-lg px-3 py-1.5 text-xs font-medium transition-colors whitespace-nowrap ${
              categoryFilter === cat
                ? 'bg-slate-200 text-slate-900 dark:bg-slate-800 dark:text-slate-100'
                : 'text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200'
            }`}
          >
            {cat === 'ALL' ? 'All Categories' : cat}
          </button>
        ))}
      </div>

      <PanelShell
        title="Available Indicators"
        subtitle={`${filtered.length} indicator definition${filtered.length === 1 ? '' : 's'}`}
        isLoading={loading}
        error={error}
        isEmpty={filtered.length === 0}
        emptyTitle="No indicators in this category"
        emptyDescription="Select another category or add a custom indicator entry."
        emptyActionLabel="Add Custom Indicator"
        onEmptyAction={() => setAddOpen(true)}
        onRetry={loadIndicators}
        skeletonRows={5}
      >
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {filtered.map((ind) => (
            <div
              key={ind.id}
              className="flex flex-col justify-between rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-[#0B0F17] p-4 space-y-4"
            >
              <div>
                <div className="flex items-start justify-between gap-2">
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="font-mono text-xs font-bold text-blue-600 dark:text-blue-400">
                        {ind.shortCode}
                      </span>
                      <span className="text-slate-400 dark:text-slate-600">·</span>
                      <span className="text-xs text-slate-500 dark:text-slate-400">{ind.category}</span>
                      {ind.isCustom && (
                        <>
                          <span className="text-slate-400 dark:text-slate-600">·</span>
                          <span className="text-[11px] font-medium text-amber-600 dark:text-amber-300">
                            Custom
                          </span>
                        </>
                      )}
