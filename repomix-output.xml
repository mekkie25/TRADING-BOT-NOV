  TradingMode,
  TwoFactorSetupInfo,
} from '../types';

import {
  AVAILABLE_PAIRS,
  MOCK_INDICATORS,
  MOCK_STRATEGIES,
} from '../mock/indicatorsAndStrategies';
import {
  MOCK_ACCOUNT_SUMMARY,
  MOCK_ACTIVITY_LOG,
  MOCK_APP_SETTINGS,
  MOCK_BOT_STATUS,
  MOCK_EQUITY_CURVE,
  MOCK_OPEN_POSITIONS,
  MOCK_RISK_SETTINGS,
} from '../mock/dashboardAndSettings';
import { MOCK_JOURNAL_TRADES } from '../mock/trades';
import {
  MOCK_BACKTEST_RESULTS,
